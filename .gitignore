# macOS
.DS_Store

# Xcode build artifacts
build/
DerivedData/
*.xcuserstate
xcuserdata/

# SwiftPM
.build/
.swiftpm/

# Editor
*.swp
.idea/
.vscode/

# Release artifacts (notarized zips, generated appcast)
dist/

# Sparkle private signing key — never commit. `sparkle generate_keys` stores
# it in the macOS Keychain by default; if it is ever exported locally, keep
# it out of the repo.
*.ed25519
sparkle_private_key*

# Vendored VAD binary (sherpa-onnx + onnxruntime, universal static, ~168 MB
# with a file >100 MB → too large for GitHub). Regenerate with
# scripts/fetch-vad-xcframework.sh. The committed silero_vad.onnx model is the
# only VAD artifact tracked in git.
/Vendor/

# Re-include agent context that a global gitignore may exclude. AGENTS.md is
# canonical; CLAUDE.md is a symlink to it. Rules and skills live in .agents/,
# with symlinks under .claude/.
!AGENTS.md
!CLAUDE.md
!.agents/
!.claude/


# Pipedream Connect credentials, written by `pd init connect`. The real secrets
# live in Supabase edge-function secrets, per branch — never in the repo.
.env
*-oauth-credentials.txt
