<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!--
      Required by the hardened runtime, not by the sandbox — Nod is not
      sandboxed, and this is still mandatory. Without it `tccd` refuses to put
      the question to the user at all: "Prompting policy for hardened runtime;
      service: kTCCServiceCalendar requires entitlement
      com.apple.security.personal-information.calendars but it is missing",
      followed by "Policy disallows prompt ... denied". EventKit then returns
      false without throwing and the authorization status stays notDetermined,
      so from inside the app a missing entitlement is indistinguishable from a
      user who said no.
    -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!--
      Sparkle is shipped via SPM and signed by the Sparkle Project. When the
      app is built with a self-signed dev cert that has no Team Identifier,
      re-signing the embedded framework can't satisfy the hardened runtime's
      Team-ID match check and the app crashes at launch with
      "have different Team IDs". Disabling library validation skips that
      check. Once we sign Release builds with a real Developer ID (same
      Team ID on app + re-signed framework) this is no longer required for
      Release, but is harmless to leave on.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
