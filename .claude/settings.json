{
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hooks/format-edited-files.sh\"",
            "statusMessage": "Formatting with SwiftFormat"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "paddle@claude-community": true,
    "swiftui-expert@swiftui-expert-skill": true,
    "swiftui-pro@swiftui-agent-skill": true
  }
}
