{
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.swift) command -v swiftformat >/dev/null && swiftformat \"$f\" --quiet || true;; esac",
            "statusMessage": "Formatting with SwiftFormat"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "paddle@claude-community": true,
    "swiftui-expert@swiftui-expert-skill": true,
    "swiftui-pro@swiftui-agent-skill": true
  }
}
