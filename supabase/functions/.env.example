# Local secrets for the billing Edge Functions. Copy to `.env` and fill in your
# Paddle SANDBOX credentials, then serve with:
#
#   supabase functions serve --env-file supabase/functions/.env
#
# In production these are set with `supabase secrets set KEY=value` instead —
# never commit the real values. `.env` is gitignored.

# Server-side Paddle API key. Sandbox keys are `pdl_sdbx_apikey_…`, live keys
# `pdl_live_apikey_…` — the function picks the matching API host from the prefix,
# so swapping sandbox↔live is just this one value.
# Dashboard: Developer Tools > Authentication > API keys.
PADDLE_API_KEY=pdl_sdbx_apikey_REPLACE_ME

# Optional override of the API host. Leave unset — it's derived from the key
# prefix (sandbox → sandbox-api.paddle.com, live → api.paddle.com).
# PADDLE_API_BASE=https://sandbox-api.paddle.com

# Webhook signing secret for the destination pointing at paddle-webhook.
# Dashboard: Developer Tools > Notifications > (your destination) > Edit.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_REPLACE_ME

# The single static "50% off, 1 recurring period" discount applied to a referred
# friend's first Pro monthly payment. Configured independently per branch, and
# `restrict_to` must list every Pro monthly price id a referral may be bought at
# (legacy + replacement) or Paddle rejects the transaction.
# Absent → referral checkout fails closed with 503 rather than charging full price.
PADDLE_REFERRAL_DISCOUNT_ID=dsc_REPLACE_ME

# --- Scheduled service workers (billing-jobs, resend-worker) ---
# pg_cron reaches these functions over HTTP, so they authenticate with this
# shared bearer instead of a user JWT. Use a different long random value per
# branch, and store the same value in the vault as `internal_job_secret`
# alongside `supabase_project_url` (see `invoke_internal_edge_job`).
INTERNAL_JOB_SECRET=replace-with-a-long-random-value

# --- Email (Resend) ---
# Nothing is sent until the program gate opens (`configure_email_policy_gate`),
# so deploying with these unset is safe: the workers simply report misconfigured.
RESEND_API_KEY=re_REPLACE_ME
RESEND_WEBHOOK_SECRET=whsec_REPLACE_ME
RESEND_PRODUCT_UPDATES_TOPIC_ID=REPLACE_ME
RESEND_LIFECYCLE_GUIDANCE_TOPIC_ID=REPLACE_ME
RESEND_FOUNDER_RESEARCH_TOPIC_ID=REPLACE_ME
# RESEND_API_BASE=https://api.resend.com

# --- Speech-to-text (llm-proxy transcribe route) ---
# The transcribe route is provider-gated by which of these keys are set:
#   • Neither set  → legacy OpenROUTER_API_KEY base64-JSON route (unchanged).
#   • GROQ_API_KEY → Groq serves primary (whisper-large-v3 / -turbo over LPU).
#   • OPENAI_API_KEY → OpenAI (whisper-1) used as the transient-failure fallback.
# OpenRouter remains the terminal fallback whenever its key is present.
# Set in prod with `supabase secrets set GROQ_API_KEY=…` — deploying the
# function before the secret lands changes nothing.
# GROQ_API_KEY=gsk_REPLACE_ME
# OPENAI_API_KEY=sk-REPLACE_ME
